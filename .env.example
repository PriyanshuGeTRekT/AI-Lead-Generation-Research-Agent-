# Copy this to .env and fill in your values

# Required: Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use via Groq (llama3-8b-8192 was decommissioned, use the one below)
GROQ_MODEL=llama-3.1-8b-instant

# Minimum qualification score (0-10) for a lead to proceed to outreach
QUALIFICATION_THRESHOLD=5.0

# Optional: LangSmith tracing (highly recommended, shows every LLM call, token
# count, latency, and agent decision in a visual dashboard)
# Get a free API key at https://smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-lead-gen

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Human-in-the-loop review via Slack (optional)
# Without this set, leads go directly to outreach_ready (default behavior, no breaking change)
# Setup: https://api.slack.com/apps -> Create App -> Incoming Webhooks -> Add to Workspace
SLACK_WEBHOOK_URL=
# Base URL used in Slack approve/reject button links
BASE_URL=http://localhost:8000

# Async pipeline execution via Celery (optional)
# Without a running Celery worker, /generate-leads runs synchronously (default behavior preserved)
# Start worker with: celery -A worker worker --loglevel=info
# Or start the full stack with: docker compose --profile full up
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# pgvector: PostgreSQL-backed vector store (optional, ChromaDB is default)
# Set USE_PGVECTOR=true and start with: docker compose --profile full up
USE_PGVECTOR=false
POSTGRES_URL=postgresql://leadgen:leadgen@postgres:5432/leadgen
