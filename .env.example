# Copy this to .env and fill in your values

# Required: Get free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Choose your open-source model via Groq
# Options: llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768 | gemma-7b-it
GROQ_MODEL=llama3-8b-8192

# Optional: Minimum score (0-10) to qualify a lead
QUALIFICATION_THRESHOLD=5.0
